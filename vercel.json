{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/batipro.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/batipro",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guide-electricien.html",
      "destination": "/guides/electricien",
      "permanent": true
    },
    {
      "source": "/guide-electricien",
      "destination": "/guides/electricien",
      "permanent": true
    },
    {
      "source": "/guide-plombier.html",
      "destination": "/guides/plombier",
      "permanent": true
    },
    {
      "source": "/guide-plombier",
      "destination": "/guides/plombier",
      "permanent": true
    },
    {
      "source": "/guide-macon.html",
      "destination": "/guides/macon",
      "permanent": true
    },
    {
      "source": "/guide-macon",
      "destination": "/guides/macon",
      "permanent": true
    },
    {
      "source": "/guide-charpentier.html",
      "destination": "/guides/charpentier",
      "permanent": true
    },
    {
      "source": "/guide-charpentier",
      "destination": "/guides/charpentier",
      "permanent": true
    },
    {
      "source": "/guide-couvreur.html",
      "destination": "/guides/couvreur",
      "permanent": true
    },
    {
      "source": "/guide-couvreur",
      "destination": "/guides/couvreur",
      "permanent": true
    },
    {
      "source": "/guide-menuisier.html",
      "destination": "/guides/menuisier",
      "permanent": true
    },
    {
      "source": "/guide-menuisier",
      "destination": "/guides/menuisier",
      "permanent": true
    },
    {
      "source": "/guide-serrurier.html",
      "destination": "/guides/serrurier",
      "permanent": true
    },
    {
      "source": "/guide-serrurier",
      "destination": "/guides/serrurier",
      "permanent": true
    },
    {
      "source": "/guide-platrier.html",
      "destination": "/guides/platrier",
      "permanent": true
    },
    {
      "source": "/guide-platrier",
      "destination": "/guides/platrier",
      "permanent": true
    },
    {
      "source": "/guide-etancheur.html",
      "destination": "/guides/etancheur",
      "permanent": true
    },
    {
      "source": "/guide-etancheur",
      "destination": "/guides/etancheur",
      "permanent": true
    },
    {
      "source": "/guide-ramoneur.html",
      "destination": "/guides/ramoneur",
      "permanent": true
    },
    {
      "source": "/guide-ramoneur",
      "destination": "/guides/ramoneur",
      "permanent": true
    },
    {
      "source": "/guide-peintre.html",
      "destination": "/guides/peintre",
      "permanent": true
    },
    {
      "source": "/guide-peintre",
      "destination": "/guides/peintre",
      "permanent": true
    },
    {
      "source": "/guide-carreleur.html",
      "destination": "/guides/carreleur",
      "permanent": true
    },
    {
      "source": "/guide-carreleur",
      "destination": "/guides/carreleur",
      "permanent": true
    },
    {
      "source": "/guide-solier.html",
      "destination": "/guides/solier",
      "permanent": true
    },
    {
      "source": "/guide-solier",
      "destination": "/guides/solier",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
